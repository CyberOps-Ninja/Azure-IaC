#!/bin/bash
# set color variables
error_color="\033[31m"
success_color="\033[32m"
info_color="\033[33m"
reset_color="\033[0m"

# pre-requisites
echo -e "${info_color}Validating Pre-requisites${reset_color}"

# webhook URL variable
WEBHOOK_URL="webhook_url_placeholder" # Replace with your actual webhook URL
# parameters/variables for Aruba EdgeConnect - resource group name and location
rg_ecv="RG-ArubaEdgeConnect-IaC" # This variable is for EdgeConnect, but you use 'rg' later
location="eastus"

# parameters/variables for Aruba EdgeConnect
sshkeyname="ssh-key-arubaedgeconnect-iac"

# create resource group if it doesn't exist
echo -e "${info_color}Creating Resource Group if it doesn't exist...${reset_color}"
az group create --name "$rg_ecv" --location "$location" --output none # Added --output none to reduce clutter
if [ $? -eq 0 ]; then
    echo -e "${success_color}Resource Group '$rg_ecv' created or already exists.${reset_color}"
else
    echo -e "${error_color}Error creating or validating Resource Group '$rg_ecv'. Exiting.${reset_color}"
    exit 1
fi

# create ssh key
echo -e "${info_color}Creating SSH Key Pair '$sshkeyname' in '$rg_ecv' at '$location'${reset_color}"
az sshkey create --location "$location" --resource-group "$rg_ecv" --name "$sshkeyname"
if [ $? -eq 0 ]; then
    echo -e "${success_color}Deployed SSH Key Pair '$sshkeyname'.${reset_color}"
    echo -e "${info_color}Please download the private key and store it in a safe location.${reset_color}"
    echo -e "${info_color}The private key is typically saved to ~/.ssh/${sshkeyname}${reset_color}"
else
    echo -e "${error_color}Error deploying SSH Key Pair '$sshkeyname'. Exiting.${reset_color}"
    exit 1
fi

echo -e "${success_color}Deployment has finished.${reset_color}"

# --- Webhook Notification Logic ---

# Function to send webhook (optional but good for reusability)
send_webhook() {
    local title=$1
    local message=$2
    local status_color=$3 # e.g., "good" (green), "attention" (yellow), "danger" (red)

    # Basic JSON payload structure for many webhook services (e.g., Teams, Slack)
    # Customize this based on your webhook service's requirements
    # For simplicity, this example uses a basic text message.
    # For more complex payloads (e.g., rich cards), you'd build a more elaborate JSON.
    JSON_PAYLOAD=$(jq -n \
        --arg title "$title" \
        --arg text "$message" \
        '{
            "text": "Deployment Notification: \($title)",
            "sections": [
                {
                    "activityTitle": "\($title)",
                    "activitySubtitle": "Aruba EdgeConnect IaC Script",
                    "facts": [
                        { "name": "Resource Group", "value": "'"$rg_ecv"'" },
                        { "name": "Location", "value": "'"$location"'" },
                        { "name": "SSH Key", "value": "'"$sshkeyname"'" },
                        { "name": "Status", "value": "'"$title"'" }
                    ],
                    "text": "\($text)"
                }
            ],
            "potentialAction": [],
            "themeColor": "'$(case "$status_color" in "success") echo "00FF00" ;; "failure") echo "FF0000" ;; *) echo "FFA500" ;; esac)'"
        }'
    )

    if [ -z "$WEBHOOK_URL" ]; then
        echo -e "${error_color}WARNING: WEBHOOK_URL is not set. Skipping notification.${reset_color}"
        return 1
    fi

    echo -e "${info_color}Sending webhook notification...${reset_color}"
    # Use curl to send the POST request
    curl -s -H "Content-Type: application/json" -X POST -d "$JSON_PAYLOAD" "$WEBHOOK_URL" > /dev/null

    if [ $? -eq 0 ]; then
        echo -e "${success_color}Webhook sent successfully.${reset_color}"
    else
        echo -e "${error_color}Failed to send webhook.${reset_color}"
    fi
}

# --- Call the webhook function on success ---
send_webhook "SUCCESS: Deployment Finished" "${success_color}Azure resources for Aruba EdgeConnect have been deployed.${reset_color}" "success"
